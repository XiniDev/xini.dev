---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Stage from '../components/Stage.astro';
import Footer from '../components/Footer.astro';
import MoreOnGitHub from '../components/MoreOnGitHub.astro';
import { site } from '../data/site';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.person.name,
  url: new URL(site.url).origin,
  jobTitle: site.person.jobTitle,
  alumniOf: site.person.alumniOf.map((name) => ({ '@type': 'CollegeOrUniversity', name })),
  worksFor: { '@type': 'Organization', name: site.person.worksFor.name, url: site.person.worksFor.url },
  sameAs: [site.contact.github, site.contact.linkedin],
};
---

<Base title={site.title} description={site.description} canonical={site.url} social>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(person)} />
  <a class="skip" href="#work" data-go="4">{site.skip}</a>
  <TopBar />
  <main>
    <Stage />
    <MoreOnGitHub />
  </main>
  <Footer />
  <script>
    import { boot } from '../lattice/index.ts';
    boot();
  </script>
</Base>
