{
  "name": "xini.dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://xini.dev/",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/size-report.ts",
    "build:test": "astro build --mode test --outDir out-test",
    "preview": "wrangler pages dev out --port 8788 --ip 127.0.0.1",
    "check": "astro check && tsc --noEmit -p workers/daily-rebuild",
    "test": "vitest run",
    "test:e2e": "npm run build:test && playwright test --grep-invert @perf && playwright test --grep @perf --workers=1",
    "lhci": "npm run build && lhci autorun",
    "size": "node scripts/size-report.ts",
    "links": "node scripts/check-links.ts",
    "snapshot:github": "node scripts/snapshot-github.ts",
    "icons": "node scripts/icons.ts",
    "og": "node scripts/og.ts",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "qa": "node scripts/qa.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "astro": "7.3.5",
    "gsap": "3.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261002.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/fontkit": "2.0.9",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "fontkit": "2.0.4",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
