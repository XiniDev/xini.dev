{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "tests/**/*", "*.config.ts"],
  "exclude": ["out", "out-test", "workers", "node_modules"]
}
